<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_horizontal">

        <!-- การ์ดหลัก -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:padding="24dp"
            android:orientation="vertical">

            <!-- หัวข้อแอป -->
            <TextView
                android:id="@+id/tvTittle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="บันทึกค่าใช้จ่ายประจำวัน"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="จดทุกบาทที่ใช้วันนี้ให้ครบเลยนะ 💸"
                android:textSize="14sp"
                android:textColor="@color/text_body"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp" />

            <!-- ช่องกรอกจำนวนเงิน -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="โปรดใส่จำนวนเงิน (เป็นบาท)"
                android:textColor="@color/text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- ช่องคำอธิบาย -->
            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input"
                android:hint="เช่น 100 หรือ 10.25"
                android:inputType="numberDecimal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_title"
                android:textColorHint="@color/input_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="คำอธิบาย"
                android:textColor="@color/text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="text"
                android:hint="เช่น ค่าอาหารกลางวัน, ค่ารถ"
                android:textColor="@color/text_title"
                android:textColorHint="@color/input_hint"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp" />

            <!-- ประเภทรายการ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ประเภทรายการ"
                android:textColor="@color/text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbExpense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔴 รายจ่าย"
                    android:checked="true"
                    android:textColor="@color/expense_color"
                    android:textStyle="bold"
                    android:buttonTint="@color/expense_color" />

                <RadioButton
                    android:id="@+id/rbIncome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟢 รายรับ"
                    android:textColor="@color/income_color"
                    android:textStyle="bold"
                    android:buttonTint="@color/income_color" />
            </RadioGroup>

            <!-- เลือกหมวดหมู่ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="หมวดหมู่"
                android:textColor="@color/text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spCategory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp" />

            <!-- ปุ่มดำเนินการ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="บันทึกข้อมูล"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_primary"
                    android:backgroundTint="@null"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="ล้างข้อมูล"
                    android:textColor="@color/btn_clear_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_secondary"
                    android:backgroundTint="@null"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- แสดงผลการบันทึก -->
            <TextView
                android:id="@+id/tvLastItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="12dp"
                android:background="@drawable/bg_result"
                android:textColor="@color/primary"
                android:textSize="14sp"
                tools:text="รายการล่าสุด: -" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@drawable/bg_result"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="ยอดรวมทั้งหมด: 0.0 บาท" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>